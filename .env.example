# Copy to .env and fill in real values for local development.
# In Kubernetes these are injected via the Secret — see DEPLOY.md and k8s/secret.example.yaml.

# Local Postgres from docker-compose.yml (docker compose up -d):
DATABASE_URL="postgresql://crm:crm_dev_password@localhost:5432/personal_crm?schema=public"

# https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."

# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# Used to build the verification link sent in emails.
APP_URL="http://localhost:3000"

# SMTP for email verification. For Gmail: use an App Password, not the
# account password — https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USERNAME=""
SMTP_PASSWORD=""
