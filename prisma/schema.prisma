// Prisma schema for Personal Networking CRM
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Application user (single-tenant owner of their own contact graph).
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  companies   Company[]
  contacts    Contact[]
  connections ContactConnection[]
}

/// A company / organization that contacts belong to.
model Company {
  id          String   @id @default(cuid())
  name        String
  industry    String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  contacts Contact[]

  @@unique([userId, name])
  @@index([userId])
}

enum ContactCategory {
  VIP
  HR
  INVESTOR
  LEAD
  COLLEAGUE
  FRIEND
  OTHER
}

/// A person in the user's network.
model Contact {
  id     String  @id @default(cuid())
  fullName String
  role   String?

  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyName String?

  usefulnessScore Int?            @db.SmallInt
  category        ContactCategory @default(OTHER)
  temperament     String?
  needs           String?         @db.Text
  valuePotential  String?         @db.Text
  fullSummary     String?         @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  interactions        Interaction[]
  outgoingConnections ContactConnection[] @relation("OutgoingConnections")
  incomingConnections ContactConnection[] @relation("IncomingConnections")

  @@index([userId])
  @@index([companyId])
}

/// Direct connection / relationship link between two contacts in the user's graph.
model ContactConnection {
  id            String   @id @default(cuid())
  userId        String
  fromContactId String
  toContactId   String
  relationship  String?  // e.g. "Колега", "Партнер", "Інвестор", "Познайомив", "Клієнт", "Друг", "Ментор"
  strength      Int      @default(1) // 1 to 5
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromContact Contact @relation("OutgoingConnections", fields: [fromContactId], references: [id], onDelete: Cascade)
  toContact   Contact @relation("IncomingConnections", fields: [toContactId], references: [id], onDelete: Cascade)

  @@unique([fromContactId, toContactId])
  @@index([userId])
  @@index([fromContactId])
  @@index([toContactId])
}

enum InteractionType {
  CALL
  MEET
  ZOOM
  OFFLINE
  NOTE
}

/// A single logged communication / meeting with a contact.
model Interaction {
  id        String           @id @default(cuid())
  type      InteractionType  @default(NOTE)
  rawText   String           @db.Text
  createdAt DateTime         @default(now())

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([createdAt])
}
