// Prisma schema for Personal Networking CRM
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Application user (single-tenant owner of their own contact graph).
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  companies           Company[]
  contacts            Contact[]
  connections         ContactConnection[]
  communities         Community[]
  verificationTokens  EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
}

/// Single-use token emailed to a user to confirm ownership of their address.
model EmailVerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Single-use token emailed to a user to reset a forgotten password.
model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A looser group affiliation a contact belongs to (meetup, alumni network,
/// professional community) — distinct from Company, which is 1 contact : 1 employer.
model Community {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  contacts Contact[] @relation("ContactCommunities")

  @@unique([userId, name])
  @@index([userId])
}

/// A company / organization that contacts belong to.
model Company {
  id          String   @id @default(cuid())
  name        String
  industry    String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  contacts Contact[]

  @@unique([userId, name])
  @@index([userId])
}

enum ContactCategory {
  VIP
  HR
  INVESTOR
  LEAD
  COLLEAGUE
  FRIEND
  OTHER
}

/// A person in the user's network.
model Contact {
  id     String  @id @default(cuid())
  fullName String
  role   String?

  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyName String?

  phone     String?
  linkedin  String?
  telegram  String?
  instagram String?
  whatsapp  String?
  city      String?
  country   String?

  usefulnessScore Int?            @db.SmallInt
  category        ContactCategory @default(OTHER)
  temperament     String?
  needs           String?         @db.Text
  valuePotential  String?         @db.Text
  fullSummary     String?         @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  interactions        Interaction[]
  outgoingConnections ContactConnection[] @relation("OutgoingConnections")
  incomingConnections ContactConnection[] @relation("IncomingConnections")
  communities         Community[]         @relation("ContactCommunities")

  @@index([userId])
  @@index([companyId])
}

/// Direct connection / relationship link between two contacts in the user's graph.
model ContactConnection {
  id            String   @id @default(cuid())
  userId        String
  fromContactId String
  toContactId   String
  relationship  String?  // e.g. "Колега", "Партнер", "Інвестор", "Познайомив", "Клієнт", "Друг", "Ментор"
  strength      Int      @default(1) // 1 to 5
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromContact Contact @relation("OutgoingConnections", fields: [fromContactId], references: [id], onDelete: Cascade)
  toContact   Contact @relation("IncomingConnections", fields: [toContactId], references: [id], onDelete: Cascade)

  interactions Interaction[]

  @@unique([fromContactId, toContactId])
  @@index([userId])
  @@index([fromContactId])
  @@index([toContactId])
}

enum InteractionType {
  CALL
  MEET
  ZOOM
  OFFLINE
  NOTE
}

/// A single logged, dated event belonging to either a Contact (an interaction
/// the user had directly) or a ContactConnection (an interaction the user
/// observed/heard about between two of their own contacts). Exactly one of
/// contactId/connectionId is set — enforced in application code, not the DB.
model Interaction {
  id           String          @id @default(cuid())
  type         InteractionType @default(NOTE)
  rawText      String          @db.Text
  /// Next step / commitment extracted from rawText, if this note mentions one
  /// (e.g. "Wednesday: talk to the academy owner"). Null when none is found.
  followUp     String?         @db.Text
  /// Structured resolution of followUp's relative date ("Wednesday" -> an
  /// absolute date), so it can be plotted on a timeline. Null when followUp
  /// has no resolvable date or is itself null.
  followUpDate DateTime?
  createdAt    DateTime        @default(now())

  contactId    String?
  contact      Contact?           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  connectionId String?
  connection   ContactConnection? @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([connectionId])
  @@index([createdAt])
}
