// Prisma schema for Personal Networking CRM
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Application user (single-tenant owner of their own contact graph).
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  companies           Company[]
  contacts            Contact[]
  connections         ContactConnection[]
  communities         Community[]
  verificationTokens  EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  apiKeys             ApiKey[]
}

/// Single-use token emailed to a user to confirm ownership of their address.
model EmailVerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Single-use token emailed to a user to reset a forgotten password.
model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum ApiKeyScope {
  READ
  READ_WRITE
}

/// A user-generated credential for the MCP server (src/app/api/mcp/route.ts),
/// letting an external AI assistant (Claude/ChatGPT/Gemini) act as this user
/// over MCP without a browser session. Only the hash is ever stored — the raw
/// key is shown once, at creation. `redactSensitive` strips PII-ish fields
/// (contact phone/socials/location, AI-derived character judgments, raw
/// interaction text) from tool results when true; `scope` gates whether
/// write tools are usable at all. Never manageable via MCP itself — only
/// through the session-authenticated settings page.
model ApiKey {
  id              String      @id @default(cuid())
  name            String
  keyHash         String      @unique
  keyPreview      String
  scope           ApiKeyScope @default(READ)
  redactSensitive Boolean     @default(true)
  expiresAt       DateTime?
  lastUsedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime    @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A looser group affiliation a contact belongs to (meetup, alumni network,
/// professional community) — distinct from Company, which is 1 contact : 1 employer.
model Community {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  contacts Contact[] @relation("ContactCommunities")

  @@unique([userId, name])
  @@index([userId])
}

/// A company / organization that contacts belong to.
model Company {
  id          String   @id @default(cuid())
  name        String
  industry    String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  contacts Contact[]

  @@unique([userId, name])
  @@index([userId])
}

enum ContactCategory {
  VIP
  HR
  INVESTOR
  LEAD
  COLLEAGUE
  FRIEND
  OTHER
}

/// A person in the user's network.
model Contact {
  id     String  @id @default(cuid())
  fullName String
  role   String?

  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyName String?

  phone     String?
  linkedin  String?
  telegram  String?
  instagram String?
  whatsapp  String?
  city      String?
  country   String?

  usefulnessScore Int?            @db.SmallInt
  category        ContactCategory @default(OTHER)
  temperament     String?
  needs           String?         @db.Text
  valuePotential  String?         @db.Text
  fullSummary     String?         @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  interactions        Interaction[]
  outgoingConnections ContactConnection[] @relation("OutgoingConnections")
  incomingConnections ContactConnection[] @relation("IncomingConnections")
  communities         Community[]         @relation("ContactCommunities")

  @@index([userId])
  @@index([companyId])
}

/// Direct connection / relationship link between two contacts in the user's graph.
model ContactConnection {
  id            String   @id @default(cuid())
  userId        String
  fromContactId String
  toContactId   String
  relationship  String?  // e.g. "Колега", "Партнер", "Інвестор", "Познайомив", "Клієнт", "Друг", "Ментор"
  strength      Int      @default(1) // 1 to 5
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromContact Contact @relation("OutgoingConnections", fields: [fromContactId], references: [id], onDelete: Cascade)
  toContact   Contact @relation("IncomingConnections", fields: [toContactId], references: [id], onDelete: Cascade)

  interactions Interaction[]

  @@unique([fromContactId, toContactId])
  @@index([userId])
  @@index([fromContactId])
  @@index([toContactId])
}

enum InteractionType {
  MEETING
  CALL
  INTRO
  EMAIL
  WORKSHOP
  MEMO
}

/// A single logged, dated event belonging to either a Contact (an interaction
/// the user had directly) or a ContactConnection (an interaction the user
/// observed/heard about between two of their own contacts). Exactly one of
/// contactId/connectionId is set — enforced in application code, not the DB.
model Interaction {
  id           String          @id @default(cuid())
  type         InteractionType @default(MEMO)
  rawText      String          @db.Text
  /// Next step / commitment extracted from rawText, if this note mentions one
  /// (e.g. "Wednesday: talk to the academy owner"). Null when none is found.
  followUp     String?         @db.Text
  /// Structured resolution of followUp's relative date ("Wednesday" -> an
  /// absolute date), so it can be plotted on a timeline. Null when followUp
  /// has no resolvable date or is itself null.
  followUpDate DateTime?
  createdAt    DateTime        @default(now())

  contactId    String?
  contact      Contact?           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  connectionId String?
  connection   ContactConnection? @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  /// A branch off an existing event (the user's own v1 -> hotfix -> v2
  /// language) — null means this interaction lives on the entity's/cluster's
  /// main line. Self-relation, one level deep by convention (not enforced by
  /// the schema): a branch's own children collapse onto it in the UI rather
  /// than nesting further, since every real example given was one level.
  parentInteractionId String?
  parent               Interaction?  @relation("InteractionBranches", fields: [parentInteractionId], references: [id], onDelete: Cascade)
  children             Interaction[] @relation("InteractionBranches")

  @@index([contactId])
  @@index([connectionId])
  @@index([createdAt])
  @@index([parentInteractionId])
}

/// Write-only trail of admin actions taken against another user's data.
/// Deliberately has no FK relation to User: an audit record should outlive
/// the account it describes, not cascade-delete alongside it. No viewer UI
/// yet (query via Prisma Studio) — reads are excluded on purpose, to avoid
/// pure noise; only writes are logged.
model AdminAuditLog {
  id           String   @id @default(cuid())
  adminUserId  String
  targetUserId String
  entityType   String
  entityId     String
  action       String
  createdAt    DateTime @default(now())

  @@index([adminUserId])
  @@index([targetUserId])
  @@index([createdAt])
}
